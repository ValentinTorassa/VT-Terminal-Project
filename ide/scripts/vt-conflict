#!/usr/bin/env bash
# vt-conflict - AI-assisted merge conflict resolution
# Usage: vt-conflict [file]
set -euo pipefail

YELLOW='\033[1;33m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
RED='\033[1;31m'
DIM='\033[2m'
RESET='\033[0m'

show_help() {
  echo -e "${CYAN}vt-conflict${RESET} - AI merge conflict resolver"
  echo ""
  echo "Usage:"
  echo "  vt-conflict             # Show all conflicted files and resolve interactively"
  echo "  vt-conflict src/app.ts  # Resolve conflicts in a specific file"
  echo "  vt-conflict --help      # Show this help"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  show_help
  exit 0
fi

for cmd in git claude; do
  if ! command -v "$cmd" &>/dev/null; then
    echo -e "${YELLOW}Missing dependency:${RESET} $cmd"
    exit 1
  fi
done

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo -e "${YELLOW}Not in a git repository${RESET}"
  exit 1
fi

# Find conflicted files
CONFLICTED=$(git diff --name-only --diff-filter=U 2>/dev/null)

if [[ -z "$CONFLICTED" ]]; then
  echo -e "${GREEN}No merge conflicts found${RESET}"
  exit 0
fi

echo -e "${RED}Conflicted files:${RESET}"
echo "$CONFLICTED" | while read -r f; do
  echo -e "  ${YELLOW}$f${RESET}"
done
echo ""

# If a specific file is provided, resolve just that one
TARGET="${1:-}"

if [[ -z "$TARGET" ]]; then
  # Only auto-pick when there is exactly one conflicted file.
  if [[ "$(printf '%s\n' "$CONFLICTED" | wc -l | tr -d ' ')" -eq 1 ]]; then
    TARGET="$CONFLICTED"
    echo -e "${CYAN}Resolving ${TARGET}${RESET}"
  else
    echo -e "${DIM}Run: vt-conflict <file> to resolve a specific file${RESET}"
    exit 1
  fi
fi

if [[ ! -f "$TARGET" ]]; then
  echo -e "${YELLOW}File not found: ${TARGET}${RESET}"
  exit 1
fi

FILE_CONTENT=$(cat "$TARGET")

# Check for conflict markers
if ! grep -q "<<<<<<< " "$TARGET"; then
  echo -e "${GREEN}No conflict markers in ${TARGET}${RESET}"
  exit 0
fi

CONFLICT_COUNT=$(grep -c "<<<<<<< " "$TARGET")
echo -e "${CYAN}Found ${CONFLICT_COUNT} conflict(s) in ${TARGET}${RESET}"
echo ""

PROMPT="Resolve the merge conflicts in this file. The file contains git conflict markers (<<<<<<< , =======, >>>>>>>).

Rules:
- Output ONLY the resolved file content
- Do not wrap the content in markdown code fences
- Do not add explanations or comments about the resolution
- Remove ALL conflict markers
- Integrate changes from BOTH sides when possible
- Keep code style consistent
- If the two sides cannot be combined, pick the safer option and leave a short code comment explaining why

File: ${TARGET}

Content:
${FILE_CONTENT}"

echo -e "${CYAN}AI resolving conflicts...${RESET}"
echo ""

if ! RESOLVED=$(claude --print <<<"$PROMPT"); then
  echo -e "${RED}Claude failed to resolve ${TARGET}${RESET}"
  exit 1
fi

# Drop a markdown fence the model may have wrapped around the whole file.
RESOLVED=$(printf '%s\n' "$RESOLVED" | sed -e '1{/^```/d;}' -e '${/^```[[:space:]]*$/d;}')

if [[ -z "${RESOLVED//[[:space:]]/}" ]]; then
  echo -e "${RED}Empty resolution - leaving ${TARGET} untouched${RESET}"
  exit 1
fi

if printf '%s\n' "$RESOLVED" | grep -E '^(<{7}|={7}|>{7})([[:space:]]|$)' >/dev/null; then
  echo -e "${RED}The AI response still contains conflict markers - leaving ${TARGET} untouched${RESET}"
  exit 1
fi

printf '%s\n' "$RESOLVED"
echo ""
echo -e "${YELLOW}Apply this resolution to ${TARGET}? [y/N]${RESET}"
read -r CONFIRM || CONFIRM=""

if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
  BACKUP="${TARGET}.vt-bak"
  cp -p "$TARGET" "$BACKUP"

  # Write through a temp file so a failed write never truncates the original.
  TMP_OUT="$(mktemp "$(dirname "$TARGET")/.vt-conflict.XXXXXX")"
  trap 'rm -f "$TMP_OUT"' EXIT
  printf '%s\n' "$RESOLVED" > "$TMP_OUT"
  mv "$TMP_OUT" "$TARGET"
  trap - EXIT

  echo -e "${GREEN}Resolved! Backup: ${BACKUP}${RESET}"
  echo -e "${GREEN}Run 'git add ${TARGET}' to mark as resolved${RESET}"
else
  echo -e "${DIM}Resolution not applied${RESET}"
fi
